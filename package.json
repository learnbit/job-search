{
  "name": "job-search-collectors",
  "version": "0.1.0",
  "private": true,
  "description": "Modular collectors for public job board APIs",
  "type": "module",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:backend": "tsx src/index.ts",
    "playground": "tsx src/playground.ts",
    "scheduler": "tsx src/runScheduler.ts",
    "prebuild": "npm run db:generate",
    "build": "npm run build:backend && next build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start": "next start",
    "start:backend": "node dist/src/index.js",
    "test": "npm run db:generate && npm run build:backend && node --test dist/test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prisma": "^7.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
